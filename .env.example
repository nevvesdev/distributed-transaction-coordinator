# Servidor
SERVIDOR_PORTA=8080
SERVIDOR_TIMEOUT_LEITURA=15s
SERVIDOR_TIMEOUT_ESCRITA=15s

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=dtc
MYSQL_USER=dtc_usuario
MYSQL_PASSWORD=dtc_senha
MYSQL_ROOT_PASSWORD=root_senha
MYSQL_MAX_CONEXOES_ABERTAS=25
MYSQL_MAX_CONEXOES_INATIVAS=25
MYSQL_TEMPO_MAXIMO_CONEXAO=5m

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_senha
REDIS_DB=0
REDIS_TIMEOUT=5s

# Transação
TRANSACAO_TIMEOUT_PADRAO=30s
TRANSACAO_TIMEOUT_PREPARE=10s
TRANSACAO_MAX_TENTATIVAS_DLQ=5
TRANSACAO_INTERVALO_BASE_RETRY=1s